---
import type { ModelPageModel } from '../../../features/storefront/models';

/**
 * Atelier — « La marque » (pageModels.ts).
 *
 * L'accroche en grand sous le titre, l'histoire, puis les engagements dans un
 * encart : un trait au-dessus, le filet de l'atelier dessous (tokens.css). Le gabarit fixe la mise en page : la largeur
 * est celle de la lettre (`--prose-*`), quel que soit le gabarit enregistré
 * avec la page, que le marchand ne choisit plus ici.
 *
 * Comme pour `ContentPage.astro` : `markdown-content` accroche la typographie
 * de prose, et chaque texte arrive déjà rendu et assaini. Une zone laissée
 * vide ne dessine rien, pas même son cadre.
 */
interface Props {
  model: ModelPageModel;
}

const { model } = Astro.props;
const accroche = model.zones.accroche?.text ?? '';
const engagements = model.zones.engagements?.html ?? '';
---

<article class="markdown-content py-10" data-page-model={model.model}>
  <h1>{model.title}</h1>
  {accroche && <p class="font-serif text-2xl leading-snug text-brand">{accroche}</p>}
  <Fragment set:html={model.html} />
  {
    engagements && (
      <aside class="atelier-rule mt-10 border-t border-line py-6">
        <Fragment set:html={engagements} />
      </aside>
    )
  }
</article>

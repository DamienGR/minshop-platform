---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import ProductDetail from '#theme/ProductDetail.astro';
import AdminEditLink from '../../features/storefront/AdminEditLink.astro';
import { productEditHref } from '../../features/auth/adminHint';
import { loadProductDetail } from '../../features/storefront/productDetail';
import { getConfig } from '../../config';
import { publicOrigin } from '../../features/http/origin';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';
import { requestThemeTexts } from '../../features/themeTexts/request';
import { t } from '../../features/i18n';

const loaded = await loadProductDetail(env.DB, {
  slug: Astro.params.slug,
  searchParams: Astro.url.searchParams,
  settings: Astro.locals.settings,
  imageBaseUrl: getConfig().images.baseUrl,
  delivery: Astro.locals.settings?.imageDelivery,
  currency: getConfig().currency,
  origin: publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN),
  pathname: Astro.url.pathname,
  // Read by middleware for the shell, in its batch (ticket #225).
  texts: requestThemeTexts(Astro.locals),
});

// Status, metadata, JSON-LD, and cache tagging stay with the route: none of
// them is a presentation decision, and all of them are easy to break silently.
if (loaded.status === 'not_found') {
  return new Response('Not found', { status: 404 });
}

const { model, purchase, seo } = loaded;
addCacheTags(Astro.response.headers, productCacheTags(loaded.cacheTagIds));
if (loaded.backfillRelated) {
  // After the response is sent, so the shopper never waits on it.
  Astro.locals.cfContext?.waitUntil(loaded.backfillRelated());
}
---

<Layout title={seo.title} seoTitle={seo.seoTitle} description={seo.description ?? undefined} image={seo.imagePath}>
  <ProductDetail model={model} purchase={purchase} />
  {/* The admin's way back to this product's screen (ticket #178): hidden from
      everyone else, and the same bytes for everyone, so the edge cache stays
      shared. */}
  <AdminEditLink href={productEditHref(model.id)} label={t('admin.products.storefrontEdit')} />

  <script is:inline type="application/ld+json" set:html={seo.jsonLd} />

  {/* Live price + hero image: reflect the chosen variant + checked add-ons. No-JS
      still works — the server computes the real price in cart/checkout. With
      or without JS the gallery opens on its first photo, the merchant's
      (ticket #185): it moves only to a variant the shopper chose. */}
  <script>
    // @ts-nocheck -- plain-JS client script (annotations would ship to the browser)
    const form = document.querySelector('[data-options-form]');
    const out = document.querySelector('[data-price-display]');
    const track = document.querySelector('[data-hero-track]');
    if (form instanceof HTMLFormElement && out instanceof HTMLElement) {
      const currency = (out.dataset.currency || 'usd').toUpperCase();
      const base = Number(out.dataset.base || '0');
      // The store's locale off <html data-locale>, never a literal: this is the
      // one price a client formats, and a tag written here would fight the
      // server's own (invariant 7). Layout.astro emits it from the same
      // constant formatMoney reads.
      const fmt = new Intl.NumberFormat(document.documentElement.dataset.locale, {
        style: 'currency',
        currency,
      });
      const divisor = 10 ** (fmt.resolvedOptions().maximumFractionDigits ?? 2);

      // Scroll the gallery carousel to the variant's linked image (if any). The
      // track is position:relative, so each image's offsetLeft is measured from the
      // track's content box — exactly the scrollLeft needed to bring it flush left.
      // data-image-id carries the gallery anchor (pimg_ public ID), never a row id.
      const showImage = (imageId) => {
        if (!(track instanceof HTMLElement) || !imageId) return;
        const img = document.getElementById(`pi-${imageId}`);
        if (img instanceof HTMLElement && track.contains(img)) {
          track.scrollLeft = img.offsetLeft;
        }
      };

      // The variant the price last reflected, so a second read of the same
      // form (pageshow, below) does not pull back a gallery the shopper moved.
      let seen = null;
      const update = (scroll) => {
        const v = form.querySelector('input[name="variant_id"]:checked');
        let cents = v ? Number(v.getAttribute('data-price')) : base;
        for (const e of form.querySelectorAll('input[name="extra"]:checked')) {
          cents += Number(e.getAttribute('data-price')) || 0;
        }
        out.textContent = fmt.format(cents / divisor);
        if (scroll && v) showImage(v.getAttribute('data-image-id') || '');
        seen = v;
      };
      // Only a change of variant moves the carousel: an add-on ticked or a
      // personalisation field left (ticket #125) keeps the photo the shopper
      // is looking at. Setting track.scrollLeft only moves the carousel, never
      // the page.
      form.addEventListener('change', (event) => {
        const target = event.target;
        update(target instanceof HTMLInputElement && target.name === 'variant_id');
      });
      // The variant checked by the server is the first in stock, not a choice:
      // the gallery stays on the merchant's first photo, the one the product
      // card, og:image and the JSON-LD show, and the only one loaded eagerly
      // (ProductGallery). A choice the browser hands back on Back is not the
      // server's default, so the gallery follows it; Chromium hands it back
      // only at pageshow, after load and with no change event, so the form is
      // read again there. A page back from the bfcache (`persisted`) is the
      // page as it was left: nothing to read.
      const sync = () => {
        const v = form.querySelector('input[name="variant_id"]:checked');
        update(Boolean(v && !v.defaultChecked && v !== seen));
      };
      sync();
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) sync();
      });
    }
  </script>

  {/* `define:vars` keeps the copied-confirmation string on the SERVER side of
      the boundary: the script is inlined with the value already substituted,
      so the message catalog never reaches the browser bundle. Importing `t`
      inside a client script would ship every storefront string to every
      visitor, which is the opposite of what near-zero client JS means. */}
  <script is:inline define:vars={{ copiedLabel: t('product.share.copied') }}>
    // @ts-nocheck -- plain-JS client script (annotations would ship to the browser)
    const btn = document.querySelector('[data-share]');
    if (btn instanceof HTMLElement) {
      const canShare = typeof navigator.share === 'function';
      const canCopy = !!navigator.clipboard?.writeText;
      if (canShare || canCopy) {
        btn.classList.remove('hidden');
        btn.classList.add('inline-flex');
        const label = btn.querySelector('[data-share-label]');
        btn.addEventListener('click', async () => {
          const url = location.href;
          const title = btn.dataset.shareTitle || document.title;
          if (canShare) {
            // Rejects when the user dismisses the share sheet — that's expected.
            try {
              await navigator.share({ title, url });
            } catch {
              /* user cancelled */
            }
            return;
          }
          await navigator.clipboard.writeText(url);
          if (label) {
            const prev = label.textContent;
            label.textContent = copiedLabel;
            setTimeout(() => {
              label.textContent = prev;
            }, 1500);
          }
        });
      }
    }
  </script>
</Layout>

---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import ProductDetail from '#theme/ProductDetail.astro';
import AdminEditLink from '../../features/storefront/AdminEditLink.astro';
import { productEditHref } from '../../features/auth/adminHint';
import { loadProductDetail } from '../../features/storefront/productDetail';
import { getConfig } from '../../config';
import { publicOrigin } from '../../features/http/origin';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';
import { requestThemeTexts } from '../../features/themeTexts/request';
import { t } from '../../features/i18n';

const loaded = await loadProductDetail(env.DB, {
  slug: Astro.params.slug,
  searchParams: Astro.url.searchParams,
  settings: Astro.locals.settings,
  imageBaseUrl: getConfig().images.baseUrl,
  delivery: Astro.locals.settings?.imageDelivery,
  currency: getConfig().currency,
  origin: publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN),
  pathname: Astro.url.pathname,
  // Read by middleware for the shell, in its batch (ticket #225).
  texts: requestThemeTexts(Astro.locals),
});

// Status, metadata, JSON-LD, and cache tagging stay with the route: none of
// them is a presentation decision, and all of them are easy to break silently.
if (loaded.status === 'not_found') {
  return new Response('Not found', { status: 404 });
}

const { model, purchase, seo } = loaded;
addCacheTags(Astro.response.headers, productCacheTags(loaded.cacheTagIds));
if (loaded.backfillRelated) {
  // After the response is sent, so the shopper never waits on it.
  Astro.locals.cfContext?.waitUntil(loaded.backfillRelated());
}
---

<Layout title={seo.title} seoTitle={seo.seoTitle} description={seo.description ?? undefined} image={seo.imagePath}>
  <ProductDetail model={model} purchase={purchase} />
  {/* The admin's way back to this product's screen (ticket #178): hidden from
      everyone else, and the same bytes for everyone, so the edge cache stays
      shared. */}
  <AdminEditLink href={productEditHref(model.id)} label={t('admin.products.storefrontEdit')} />

  <script is:inline type="application/ld+json" set:html={seo.jsonLd} />

  {/* Live price + hero image: reflect the chosen variant + checked add-ons, and
      the personalisation fields that go with them. No-JS
      still works — the server computes the real price in cart/checkout. With
      or without JS the gallery opens on its first photo, the merchant's
      (ticket #185): it moves only to a variant the shopper chose. */}
  <script>
    // @ts-nocheck -- plain-JS client script (annotations would ship to the browser)
    const form = document.querySelector('[data-options-form]');
    const out = document.querySelector('[data-price-display]');
    const track = document.querySelector('[data-hero-track]');

    // The gallery changes photo by a cross-fade, never by sliding past the
    // photos in between (ticket #235, ProductGallery). The track jumps to the
    // photo at once, under a copy of the one that was showing (the veil), and
    // the veil leaves the way the stylesheet says: a fade in base.css, which a
    // theme may restyle. The track is position:relative, so a frame's
    // offsetLeft is measured from its content box: exactly the scrollLeft
    // that brings the frame flush left.
    let show = null;
    const frames = track instanceof HTMLElement ? [...track.querySelectorAll('img[id^="pi-"]')] : [];
    if (frames.length > 0) {
      const hero = track.closest('[data-product-hero]') || track;
      const thumbs = [...hero.querySelectorAll('a[href^="#pi-"]')];
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');
      // The frame on screen: the nearest to the scroll position, as a swipe
      // can leave the track between two for a moment.
      const onScreen = () =>
        frames.reduce((a, b) =>
          Math.abs(b.offsetLeft - track.scrollLeft) < Math.abs(a.offsetLeft - track.scrollLeft) ? b : a,
        );
      // The thumbnail of the photo on screen says so: with a fade, nothing
      // else tells where the shopper is in the series.
      const mark = (frame) => {
        for (const thumb of thumbs) {
          if (thumb.getAttribute('href') === `#${frame.id}`) thumb.setAttribute('aria-current', 'true');
          else thumb.removeAttribute('aria-current');
        }
      };
      // A layer over a frame, inside the track so it scrolls with it, and
      // before the sold-out label so the label stays on top.
      const lay = (layer, frame) => {
        Object.assign(layer.style, {
          left: `${frame.offsetLeft}px`,
          top: `${frame.offsetTop}px`,
          width: `${frame.offsetWidth}px`,
          height: `${frame.offsetHeight}px`,
        });
        frames[frames.length - 1].after(layer);
      };
      let turn = 0;
      show = async (img) => {
        const mine = ++turn;
        mark(img);
        for (const wait of track.querySelectorAll('[data-hero-wait]')) wait.remove();
        // Every frame but the first is lazy. The one asked for loads now, and
        // the photo on screen stays until the next can be drawn: never an
        // empty frame. A load that lasts shows the waiting mark over it.
        if (!img.complete) {
          img.loading = 'eager';
          track.setAttribute('aria-busy', 'true');
          const wait = document.createElement('span');
          wait.setAttribute('data-hero-wait', '');
          lay(wait, onScreen());
          await img.decode().catch(() => {});
          wait.remove();
          if (mine !== turn) return;
        }
        track.removeAttribute('aria-busy');
        const from = onScreen();
        if (from === img) return;
        // The veil is the file already on screen, decoded before it goes up so
        // it never flashes blank. It comes from memory; a browser that would
        // fetch it again gets no fade rather than a wait. Reduced motion: no
        // veil, the photo changes at once.
        let veil = null;
        if (!still.matches) {
          veil = document.createElement('img');
          veil.src = from.currentSrc || from.src;
          veil.alt = '';
          veil.className = from.className;
          veil.setAttribute('data-hero-veil', '');
          await Promise.race([veil.decode(), new Promise((done) => setTimeout(done, 100))]).catch(() => {});
          if (mine !== turn) return;
          if (!veil.complete) veil = null;
        }
        for (const old of track.querySelectorAll('[data-hero-veil]')) old.remove();
        track.scrollTo({ left: img.offsetLeft, behavior: 'instant' });
        if (!veil) return;
        lay(veil, img);
        // Its style is read once before it leaves, or there is no transition.
        // How it leaves is the stylesheet's; the script waits for whatever
        // that started (none, a fade, a theme's sweep) and takes it away.
        void getComputedStyle(veil).opacity;
        veil.setAttribute('data-hero-veil', 'out');
        const leaving = veil.getAnimations?.() ?? [];
        Promise.race([
          Promise.allSettled(leaving.map((a) => a.finished)),
          new Promise((done) => setTimeout(done, 3000)),
        ]).then(() => veil.remove());
      };

      // A swipe moves the track by itself: once it rests, the mark follows.
      let resting = 0;
      track.addEventListener(
        'scroll',
        () => {
          clearTimeout(resting);
          resting = setTimeout(() => {
            if (!track.hasAttribute('aria-busy')) mark(onScreen());
          }, 120);
        },
        { passive: true },
      );
      mark(onScreen());

      // A thumbnail is a link to its frame, all it is without a script. With
      // one, the click is the gallery's: no #pi- fragment in the address and
      // the history, and the page stays where it is. A click that opens a tab
      // or a window stays the browser's.
      const frameOf = (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href^="#pi-"]') : null;
        const img = link ? document.getElementById(link.getAttribute('href').slice(1)) : null;
        return img instanceof HTMLImageElement && track.contains(img) ? img : null;
      };
      hero.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const img = frameOf(event);
        if (!img) return;
        event.preventDefault();
        show(img);
      });
      // The pointer on a thumbnail starts its photo's load: by the click, it
      // is often there.
      hero.addEventListener('pointerover', (event) => {
        const img = frameOf(event);
        if (img) img.loading = 'eager';
      });
    }

    if (form instanceof HTMLFormElement && out instanceof HTMLElement) {
      const currency = (out.dataset.currency || 'usd').toUpperCase();
      const base = Number(out.dataset.base || '0');
      // The store's locale off <html data-locale>, never a literal: this is the
      // one price a client formats, and a tag written here would fight the
      // server's own (invariant 7). Layout.astro emits it from the same
      // constant formatMoney reads.
      const fmt = new Intl.NumberFormat(document.documentElement.dataset.locale, {
        style: 'currency',
        currency,
      });
      const divisor = 10 ** (fmt.resolvedOptions().maximumFractionDigits ?? 2);

      // The variant's linked image (if any), by the gallery's own change of
      // photo. data-image-id carries the gallery anchor (pimg_ public ID),
      // never a row id.
      const showImage = (imageId) => {
        const img = imageId ? document.getElementById(`pi-${imageId}`) : null;
        if (show && img instanceof HTMLImageElement && track.contains(img)) show(img);
      };

      // The variant the price last reflected, so a second read of the same
      // form (pageshow, below) does not pull back a gallery the shopper moved.
      let seen = null;
      const update = (scroll) => {
        const v = form.querySelector('input[name="variant_id"]:checked');
        let cents = v ? Number(v.getAttribute('data-price')) : base;
        for (const e of form.querySelectorAll('input[name="extra"]:checked')) {
          cents += Number(e.getAttribute('data-price')) || 0;
        }
        out.textContent = fmt.format(cents / divisor);
        if (scroll && v) showImage(v.getAttribute('data-image-id') || '');
        seen = v;
      };
      // Only a change of variant moves the carousel: an add-on ticked or a
      // personalisation field left (ticket #125) keeps the photo the shopper
      // is looking at. Moving the track never moves the page.
      form.addEventListener('change', (event) => {
        const target = event.target;
        update(target instanceof HTMLInputElement && target.name === 'variant_id');
      });
      // The variant checked by the server is the first in stock, not a choice:
      // the gallery stays on the merchant's first photo, the one the product
      // card, og:image and the JSON-LD show, and the only one loaded eagerly
      // (ProductGallery). A choice the browser hands back on Back is not the
      // server's default, so the gallery follows it; Chromium hands it back
      // only at pageshow, after load and with no change event, so the form is
      // read again there. A page back from the bfcache (`persisted`) is the
      // page as it was left: nothing to read.
      const sync = () => {
        const v = form.querySelector('input[name="variant_id"]:checked');
        update(Boolean(v && !v.defaultChecked && v !== seen));
      };
      sync();
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) sync();
      });
    }

    // A personalisation field that goes with an extra (migration 0064) is
    // asked only while that box is ticked. base.css shows and hides it; here
    // it is also disabled while hidden, so that it is neither sent nor
    // validated, and required while shown when the merchant made it so.
    // Without this script the server judges alone: it drops the text of an
    // unticked extra and refuses a required one left blank.
    if (form instanceof HTMLFormElement) {
      const groups = [...form.querySelectorAll('[data-extra-choice]')];
      const follow = () => {
        for (const group of groups) {
          const box = group.querySelector('input[name="extra"]');
          const fields = group.querySelector('[data-extra-fields]');
          if (!(box instanceof HTMLInputElement) || !(fields instanceof HTMLElement)) continue;
          fields.hidden = !box.checked;
          for (const input of fields.querySelectorAll('input')) {
            input.disabled = !box.checked;
            input.required = box.checked && input.hasAttribute('data-required');
          }
        }
      };
      if (groups.length > 0) {
        follow();
        form.addEventListener('change', follow);
        // A box the browser ticks again on Back comes with no change event.
        window.addEventListener('pageshow', follow);
      }
    }
  </script>

  {/* `define:vars` keeps the copied-confirmation string on the SERVER side of
      the boundary: the script is inlined with the value already substituted,
      so the message catalog never reaches the browser bundle. Importing `t`
      inside a client script would ship every storefront string to every
      visitor, which is the opposite of what near-zero client JS means. */}
  <script is:inline define:vars={{ copiedLabel: t('product.share.copied') }}>
    // @ts-nocheck -- plain-JS client script (annotations would ship to the browser)
    const btn = document.querySelector('[data-share]');
    if (btn instanceof HTMLElement) {
      const canShare = typeof navigator.share === 'function';
      const canCopy = !!navigator.clipboard?.writeText;
      if (canShare || canCopy) {
        btn.classList.remove('hidden');
        btn.classList.add('inline-flex');
        const label = btn.querySelector('[data-share-label]');
        btn.addEventListener('click', async () => {
          const url = location.href;
          const title = btn.dataset.shareTitle || document.title;
          if (canShare) {
            // Rejects when the user dismisses the share sheet — that's expected.
            try {
              await navigator.share({ title, url });
            } catch {
              /* user cancelled */
            }
            return;
          }
          await navigator.clipboard.writeText(url);
          if (label) {
            const prev = label.textContent;
            label.textContent = copiedLabel;
            setTimeout(() => {
              label.textContent = prev;
            }, 1500);
          }
        });
      }
    }
  </script>
</Layout>

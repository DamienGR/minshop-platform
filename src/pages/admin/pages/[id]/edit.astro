---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import MarkdownEditor from '../../../../features/pages/MarkdownEditor.astro';
import PageZoneFields from '../../../../features/pageModels/PageZoneFields.astro';
import { getPageByPublicId } from '../../../../features/pages/db';
import {
  PAGE_LAYOUT_OPTIONS,
  normalizePageLayout,
} from '../../../../features/pages/layouts';
import { activePageModels } from '../../../../features/pageModels/active';
import { isListZone, pageModelOf } from '../../../../features/pageModels/declaration';
import { readStoredZones } from '../../../../features/pageModels/zones';
import { parsePublicId } from '../../../../features/ids/publicId';
import { t } from '../../../../features/i18n';

// The route param is the page_ public ID; numeric row ids are not accepted.
const publicId = parsePublicId(Astro.params.id, 'page');
const page = publicId ? await getPageByPublicId(env.DB, publicId) : null;
if (!page) return new Response(t('admin.pages.notFound'), { status: 404 });

const error = Astro.url.searchParams.get('error');
const warning = Astro.url.searchParams.get('warning');
const saved = Astro.url.searchParams.has('saved');
const currentLayout = normalizePageLayout(page.layout);

// The theme's page models (ADR 0031). The choice is offered only when the
// theme declares some; the zones shown are those of the model the page HAS,
// since a new model's zones are what the save that chooses it brings.
const models = activePageModels;
const pageModel = pageModelOf(models, page.model);
// A key the theme no longer declares: the page reads as « Basique ».
const lostModel = page.model !== '' && !pageModel ? page.model : null;
const zones = readStoredZones(page.zones);
const modelHint = pageModel ? (pageModel.help ?? '') : t('admin.pages.model.basic.hint');
// Enter in a line of text submits with the form's first submit button: with a
// list on the page, that would be a « Monter » or « Descendre ».
const hasLists = !!pageModel?.zones.some(isListZone);
---

<AdminLayout title={t('admin.pages.edit.documentTitle', { titre: page.title })} active="pages">
  <a href="/admin/pages" class="text-sm text-gray-500 hover:text-brand">
    &larr; {t('admin.pages.backToList')}
  </a>
  <div class="mt-4 mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-serif text-3xl tracking-tight">{t('admin.pages.edit.heading')}</h1>
    {
      page.published !== 0 && (
        <a
          href={`/pages/${page.slug}`}
          target="_blank"
          rel="noopener"
          class="text-sm text-accent hover:underline"
        >
          {t('admin.pages.edit.viewOnStore')} ↗
        </a>
      )
    }
  </div>

  {
    error && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {error}
      </p>
    )
  }
  {
    warning && (
      <p class="mb-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        {warning}
      </p>
    )
  }
  {
    saved && !warning && (
      <p class="mb-6 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        {t('admin.common.saved')}
      </p>
    )
  }

  <form method="POST" action={`/api/admin/pages/${page.public_id}`} data-page-form>
    {
      hasLists && (
        <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">
          {t('admin.common.save')}
        </button>
      )
    }
    <div class="flex flex-wrap gap-4">
      <label class="block flex-1 text-xs uppercase tracking-widest text-gray-400">
        {t('admin.pages.field.title')}
        <input
          type="text"
          name="title"
          value={page.title}
          required
          maxlength="120"
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
        />
      </label>
      <label class="block flex-1 text-xs uppercase tracking-widest text-gray-400">
        {t('admin.pages.field.slug')}
        <input
          type="text"
          name="slug"
          value={page.slug}
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
        />
      </label>
    </div>

    {
      models.length > 0 && (
        <label class="mt-6 block max-w-sm text-xs uppercase tracking-widest text-gray-400">
          {t('admin.pages.field.model')}
          <select
            name="model"
            data-model-select
            data-saved={pageModel?.key ?? ''}
            class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
          >
            <option value="" data-hint={t('admin.pages.model.basic.hint')} selected={!pageModel}>
              {t('admin.pages.model.basic.label')}
            </option>
            {models.map((model) => (
              <option value={model.key} data-hint={model.help ?? ''} selected={model.key === pageModel?.key}>
                {model.label}
              </option>
            ))}
          </select>
          <span data-model-hint class="mt-1 block normal-case tracking-normal text-gray-400">
            {modelHint}
          </span>
          {/* Shown by the script once the choice differs from the saved one;
              without it, the hint below says the same for every change. */}
          <span data-model-pending hidden class="mt-1 block normal-case tracking-normal text-amber-700">
            {t('admin.pages.model.switchPending')}
          </span>
          <noscript>
            <span class="mt-1 block normal-case tracking-normal text-gray-400">
              {t('admin.pages.model.switchHint')}
            </span>
          </noscript>
        </label>
      )
    }
    {
      lostModel && (
        <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          {t('admin.pages.model.unknown', { modele: lostModel })}
        </p>
      )
    }

    {/* The body, every page has one; a model names it. Then the model's
        zones, each Markdown one with its own editor and Aperçu. */}
    <MarkdownEditor
      name="body_markdown"
      id="page-body"
      value={page.body_markdown}
      label={pageModel?.body.label}
      help={pageModel?.body.help}
    />
    {pageModel && <PageZoneFields model={pageModel} zones={zones} />}

    {/* Options are generated from features/pages/layouts.ts — adding a preset
        there adds it here with no change to this file. A model draws its own
        layout: the page keeps the one it had, for a return to « Basique ». */}
    {
      pageModel ? (
        <input type="hidden" name="layout" value={currentLayout} />
      ) : (
        <label class="mt-6 block max-w-sm text-xs uppercase tracking-widest text-gray-400">
          {t('admin.pages.field.layout')}
          <select
            name="layout"
            data-layout-select
            class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
          >
            {PAGE_LAYOUT_OPTIONS.map((option) => (
              <option value={option.key} data-hint={option.hint} selected={option.key === currentLayout}>
                {option.label}
              </option>
            ))}
          </select>
          <span data-layout-hint class="mt-1 block normal-case tracking-normal text-gray-400">
            {PAGE_LAYOUT_OPTIONS.find((o) => o.key === currentLayout)?.hint}
          </span>
        </label>
      )
    }

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" name="published" checked={page.published !== 0} class="rounded" />
        {t('admin.pages.status.published')}
      </label>
      <button
        type="submit"
        class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
      >
        {t('admin.common.save')}
      </button>
      {/* The draft, in the theme's own page, in a new tab: the form posts
          there instead, and nothing is saved (ADR 0031). */}
      <button
        type="submit"
        formaction={`/admin/pages/${page.public_id}/preview`}
        formtarget="_blank"
        title={t('admin.pages.preview.pageHint')}
        class="rounded-md border border-line px-4 py-2 text-xs font-medium uppercase tracking-wider text-gray-600 hover:border-brand hover:text-brand"
      >
        {t('admin.pages.preview.page')} ↗
      </button>
      <span class="text-xs text-gray-400">
        {t('admin.pages.edit.publishHint')}
      </span>
    </div>
  </form>
</AdminLayout>

<script>
  // Keep each choice's hint in step with it. The hints are read from the
  // rendered options' data attributes, so this needs no per-option code.
  const form = document.querySelector<HTMLFormElement>('[data-page-form]');
  // Cast rather than parameterise: the Workers `Element` type in scope here
  // doesn't satisfy querySelector's generic constraint for HTMLSelectElement.
  const layoutSelect = form?.querySelector('[data-layout-select]') as HTMLSelectElement | null;
  const layoutHint = form?.querySelector<HTMLElement>('[data-layout-hint]');
  layoutSelect?.addEventListener('change', () => {
    const hint = layoutSelect.selectedOptions[0]?.dataset.hint;
    if (layoutHint && hint) layoutHint.textContent = hint;
  });

  // The zones on screen are the saved model's: a new choice says it takes a
  // save to show its own.
  const modelSelect = form?.querySelector('[data-model-select]') as HTMLSelectElement | null;
  const modelHint = form?.querySelector<HTMLElement>('[data-model-hint]');
  const modelPending = form?.querySelector<HTMLElement>('[data-model-pending]');
  modelSelect?.addEventListener('change', () => {
    if (modelHint) modelHint.textContent = modelSelect.selectedOptions[0]?.dataset.hint ?? '';
    if (modelPending) modelPending.hidden = modelSelect.value === modelSelect.dataset.saved;
  });
</script>

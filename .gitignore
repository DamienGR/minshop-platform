# Dependencies (root + mcp/ subproject — non-anchored, matches at any depth)
node_modules/

# Build output
dist/
.astro/
.output/

# Cloudflare / Wrangler local state (also covers mcp/.wrangler, mcp/.dev.vars)
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Per-instance provisioning artifacts (scripts/provision-cf.sh)
.instances/
wrangler.jsonc.bak
# NOTE: /wrangler.jsonc is now COMMITTED (free-plan default + Deploy-button config,
# with a placeholder database_id). provision-cf.sh renders instance ids over it and
# restores it on exit. Keep real deployed-instance configs OUTSIDE the repo.
/mcp/wrangler.jsonc

# Backups and their key (shopctl backup / restore, ADR 0005).
# An archive is the merchant's orders, addresses and e-mails — encrypted, and
# still not something a repository holds. The key is what opens every archive
# taken with it: it belongs in the operator's vault, never in a clone.
backups/
.shopctl/

# An RGPD export (shopctl privacy export). One person's orders, addresses and
# e-mail, in the clear — that is what article 20 asks for, and it is the last
# thing a repository should hold. It is written for one requester and deleted
# once it has been sent to them. Anchored: `shopctl/src/privacy/` is the code
# that writes one, and an unanchored rule would quietly untrack it.
/privacy/

# Environment & local overrides
.env
.env.*
*.local

# Claude Code — local, machine-specific settings (project settings.json stays tracked)
.claude/settings.local.json

# Tooling artifacts
.playwright-mcp/
# Playwright run output (traces + screenshots of failures, HTML report).
# The committed artefact of the browser suite is test/browser/__signatures__/.
test-results/
playwright-report/
coverage/
.overmind.sock

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
# Generated theme artifacts (scripts/theme-css.mjs)
src/styles/themes/
tsconfig.theme.json
tsconfig.theme.*.json
